# ============================================================
# IGNORE-BY-DEFAULT POLICY
# Every file is ignored by default ("*"). A file is committable
# ONLY after it gets an explicit un-ignore line ("!<path>", or
# "!<dir>/**" for a whole tree) added in the same commit.
# Never bypass this with "git add -f".
# Check a path: git check-ignore -v <path>   (no output = not ignored)
# ============================================================

# --- 1. Default: ignore everything ---
*

# --- 2. Keep needed directories traversable so nested "!path" lines work ---
# Scoped on purpose: a blanket "!*/" would re-include ignored dirs like
# .codegraph/ and let their inner .gitignore files leak through.
!Chet/
!ChetCore/
!ChetHelper/
!docs/
!scripts/

# --- 3. Committable files (un-ignore list; add "!<path>" here in the same commit) ---
# Anchored to the repo root so nested dotfiles (e.g. .codegraph/.gitignore) stay ignored.
!/.gitignore
!/project.yml
!/mise.toml
!/README.md
!/DEVELOPMENT.md
!/AGENTS.md
!/.swift-format
!/CLAUDE.md
!Chet/**
!ChetCore/**
!ChetHelper/**
!docs/DESIGN.md
!docs/images/
!docs/images/**
!docs/USER-GUIDE.md
!docs/findings.md
!docs/lessons.md
!docs/perf-findings.md
!docs/design/
!docs/design/**
!scripts/axdrv.swift
!scripts/bump-build.sh
!scripts/install-chet.sh
!scripts/dedupe-launchservices.sh
!scripts/publish-release.sh
!scripts/layout_check.py
!scripts/ui_id_audit.py
!scripts/ui_selectors.py

# --- 4. Explicit re-ignores inside committable trees ---
ChetCore/.build/
ChetCore/.swiftpm/
.DS_Store
